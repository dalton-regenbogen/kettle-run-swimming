{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Practice schedule (as rules)",
  "description": "src/assets/data/practice-schedule.json. The build turns these rules into every practice day. A meet on a practice day turns that practice off automatically.",
  "type": "object",
  "required": ["season", "first", "last", "days", "time", "location"],
  "additionalProperties": false,
  "properties": {
    "season": { "type": "string", "pattern": "^\\d{4}-\\d{4}$", "description": "The season, like \"2026-2027\"." },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "When the schedule last changed. Shown as \"Last updated\" on the Practices page." },
    "first": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The first practice, like \"2026-11-09\"." },
    "last": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The last practice, like \"2027-02-18\"." },
    "days": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
      "description": "The usual practice days."
    },
    "time": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}( ?(AM|PM))? ?[-–] ?\\d{1,2}:\\d{2} ?(AM|PM)$", "description": "The usual time, like \"3:30-4:30 PM\"." },
    "location": { "type": "string", "description": "The usual place, like \"WARF\"." },
    "changes": {
      "type": "array",
      "description": "Days that are different: off, or at another time or place. Meet days don't need to be listed.",
      "items": {
        "type": "object",
        "required": ["date"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day, or the first day of a range." },
          "through": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The last day of a range (optional)." },
          "off": { "type": "boolean", "description": "true = no practice." },
          "time": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}( ?(AM|PM))? ?[-–] ?\\d{1,2}:\\d{2} ?(AM|PM)$", "description": "A different time, like \"5:00-6:00 PM\"." },
          "location": { "type": "string", "description": "A different place." },
          "note": { "type": "string", "description": "A reminder for you, like \"Thanksgiving break\" (not shown on the site)." }
        }
      }
    }
  }
}
